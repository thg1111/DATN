pipeline {
    agent any

    options {
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '20'))
        skipDefaultCheckout(true)
    }

    parameters {
        string(name: 'GIT_URL', defaultValue: 'https://github.com/thg1111/DATN.git', description: 'Git repository URL de Jenkins clone source.')
        string(name: 'GIT_BRANCH', defaultValue: 'dev', description: 'Nhanh can clone de chay test.')
        string(name: 'REPO_ROOT', defaultValue: '', description: 'Override repo root neu can. Mac dinh la %WORKSPACE%\\DahlaFlowerShop sau khi clone DATN.')
        string(name: 'FRONTEND_PORT', defaultValue: '5500', description: 'Port frontend static server cho Selenium.')
        string(name: 'API_BASE_URL', defaultValue: 'https://localhost:7114', description: 'Base URL cua gateway/API de frontend goi test.')
        booleanParam(name: 'SKIP_DB_SETUP', defaultValue: false, description: 'Bo qua setup LocalDB neu database da san sang.')
        booleanParam(name: 'KEEP_SERVICES', defaultValue: true, description: 'Giu service chay sau khi test xong.')
    }

    environment {
        DOTNET_CLI_TELEMETRY_OPTOUT = '1'
        DOTNET_NOLOGO = '1'
        DEFAULT_GIT_URL = 'https://github.com/thg1111/DATN.git'
        DEFAULT_GIT_BRANCH = 'dev'
    }

    stages {
        stage('Checkout Source') {
            steps {
                script {
                    env.EFFECTIVE_GIT_URL = params.GIT_URL?.trim() ? params.GIT_URL.trim() : env.DEFAULT_GIT_URL
                    env.EFFECTIVE_GIT_BRANCH = params.GIT_BRANCH?.trim() ? params.GIT_BRANCH.trim() : env.DEFAULT_GIT_BRANCH

                    checkout([
                        $class: 'GitSCM',
                        branches: [[name: "*/${env.EFFECTIVE_GIT_BRANCH}"]],
                        userRemoteConfigs: [[url: env.EFFECTIVE_GIT_URL]],
                        extensions: [[$class: 'CleanBeforeCheckout']]
                    ])
                }
                bat '''
@echo off
chcp 65001>nul
echo Checked out %EFFECTIVE_GIT_URL%
echo Branch: %EFFECTIVE_GIT_BRANCH%
'''
            }
        }

        stage('Resolve Paths') {
            steps {
                script {
                    env.EFFECTIVE_REPO_ROOT = params.REPO_ROOT?.trim() ? params.REPO_ROOT.trim() : "${env.WORKSPACE}\\DahlaFlowerShop"
                    env.EFFECTIVE_FRAMEWORK_ROOT = "${env.EFFECTIVE_REPO_ROOT}\\test\\AutomationFramework"
                    env.EFFECTIVE_FRONTEND_PORT = params.FRONTEND_PORT?.trim() ? params.FRONTEND_PORT.trim() : '5500'
                    env.EFFECTIVE_FRONTEND_BASE_URL = "http://127.0.0.1:${env.EFFECTIVE_FRONTEND_PORT}"
                    env.EFFECTIVE_API_BASE_URL = params.API_BASE_URL?.trim() ? params.API_BASE_URL.trim() : 'https://localhost:7114'
                }
                bat '''
@echo off
chcp 65001>nul
echo Workspace         : %WORKSPACE%
echo Repo root         : %EFFECTIVE_REPO_ROOT%
echo Framework root    : %EFFECTIVE_FRAMEWORK_ROOT%
echo Frontend base URL : %EFFECTIVE_FRONTEND_BASE_URL%
echo API base URL      : %EFFECTIVE_API_BASE_URL%
'''
            }
        }

        stage('Check Environment') {
            steps {
                bat '''
@echo off
chcp 65001>nul
if not exist "%EFFECTIVE_REPO_ROOT%" (
    echo Source path not found: %EFFECTIVE_REPO_ROOT%
    exit /b 1
)
if not exist "%EFFECTIVE_REPO_ROOT%\\run-local-web.bat" (
    echo Missing run-local-web.bat
    exit /b 1
)
if not exist "%EFFECTIVE_FRAMEWORK_ROOT%\\pytest.ini" (
    echo Missing AutomationFramework pytest.ini
    exit /b 1
)
if not exist "%EFFECTIVE_FRAMEWORK_ROOT%\\requirements.txt" (
    echo Missing AutomationFramework requirements.txt
    exit /b 1
)
if not exist "%EFFECTIVE_FRAMEWORK_ROOT%\\tests\\test_login.py" (
    echo Missing tests\\test_login.py
    exit /b 1
)
if not exist "%EFFECTIVE_FRAMEWORK_ROOT%\\tests\\test_keyword_driven.py" (
    echo Missing tests\\test_keyword_driven.py
    exit /b 1
)
where dotnet
dotnet --version
where node
node --version
where py >nul 2>nul
if %ERRORLEVEL% EQU 0 (
    py -3 --version
) else (
    where python
    python --version
)
'''
            }
        }

        stage('Install Python Dependencies') {
            steps {
                bat '''
@echo off
chcp 65001>nul
cd /d "%EFFECTIVE_FRAMEWORK_ROOT%"

where py >nul 2>nul
if %ERRORLEVEL% EQU 0 (
    set "PYTHON_CMD=py -3"
) else (
    set "PYTHON_CMD=python"
)

%PYTHON_CMD% -m pip install -r requirements.txt
exit /b %ERRORLEVEL%
'''
            }
        }

        stage('Start Or Reuse Local Web') {
            steps {
                bat '''
@echo off
chcp 65001>nul
cd /d "%EFFECTIVE_REPO_ROOT%"

set "WEB_ARGS=-FrontendPort %EFFECTIVE_FRONTEND_PORT% -NoBrowser -SkipCertTrust -ReuseRunning"
if /I "%SKIP_DB_SETUP%"=="true" set "WEB_ARGS=%WEB_ARGS% -SkipDbSetup"

echo call "%EFFECTIVE_REPO_ROOT%\\run-local-web.bat" %WEB_ARGS%
call "%EFFECTIVE_REPO_ROOT%\\run-local-web.bat" %WEB_ARGS%
exit /b %ERRORLEVEL%
'''
            }
        }

        stage('Run Data Driven Auth Tests') {
            steps {
                bat '''
@echo off
chcp 65001>nul
cd /d "%EFFECTIVE_FRAMEWORK_ROOT%"
set "FRONTEND_BASE_URL=%EFFECTIVE_FRONTEND_BASE_URL%"
set "API_BASE_URL=%EFFECTIVE_API_BASE_URL%"

where py >nul 2>nul
if %ERRORLEVEL% EQU 0 (
    set "PYTHON_CMD=py -3"
) else (
    set "PYTHON_CMD=python"
)

if not exist reports mkdir reports
%PYTHON_CMD% -m pytest tests\\test_login.py -v --html=reports\\data-driven-auth-report.html --self-contained-html
exit /b %ERRORLEVEL%
'''
            }
        }

        stage('Run Keyword Driven Website Tests') {
            steps {
                bat '''
@echo off
chcp 65001>nul
cd /d "%EFFECTIVE_FRAMEWORK_ROOT%"
set "FRONTEND_BASE_URL=%EFFECTIVE_FRONTEND_BASE_URL%"
set "API_BASE_URL=%EFFECTIVE_API_BASE_URL%"

where py >nul 2>nul
if %ERRORLEVEL% EQU 0 (
    set "PYTHON_CMD=py -3"
) else (
    set "PYTHON_CMD=python"
)

if not exist reports mkdir reports
%PYTHON_CMD% -m pytest tests\\test_keyword_driven.py -v --html=reports\\keyword-driven-website-report.html --self-contained-html
exit /b %ERRORLEVEL%
'''
            }
        }

        stage('Sync HTML Reports') {
            steps {
                bat '''
@echo off
chcp 65001>nul
if not exist "%EFFECTIVE_FRAMEWORK_ROOT%\\reports" (
    echo No HTML report folder found.
    exit /b 0
)
if not exist "%WORKSPACE%\\test\\reports" mkdir "%WORKSPACE%\\test\\reports"
robocopy "%EFFECTIVE_FRAMEWORK_ROOT%\\reports" "%WORKSPACE%\\test\\reports" *.html /NFL /NDL /NJH /NJS /NC /NS
if %ERRORLEVEL% LEQ 7 exit /b 0
exit /b %ERRORLEVEL%
'''
            }
        }
    }

    post {
        always {
            bat '''
@echo off
chcp 65001>nul
if /I "%KEEP_SERVICES%"=="true" (
    echo KEEP_SERVICES=true, skip stopping local web services.
    exit /b 0
)
if exist "%EFFECTIVE_REPO_ROOT%\\ci\\stop-local-web.ps1" (
    powershell -NoProfile -ExecutionPolicy Bypass -File "%EFFECTIVE_REPO_ROOT%\\ci\\stop-local-web.ps1"
)
exit /b 0
'''
            archiveArtifacts allowEmptyArchive: true, fingerprint: true, artifacts: 'test/reports/**/*.html,DahlaFlowerShop/test/AutomationFramework/reports/**/*.html,DahlaFlowerShop/test/AutomationFramework/testdata/**/*.xlsx'
        }
    }
}
